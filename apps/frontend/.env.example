# Copy to .env.local and fill in values before running the dev server.

# AI Extraction
# Leave blank to fall back to cached vendor extractions (demo mode).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Demo mode (read by lib/demoMode.ts — server-side only, do NOT add NEXT_PUBLIC_ prefix).
# Options: live-ai-live-proof | cached-ai-live-proof | cached-ai-cached-proof
DEMO_MODE=cached-ai-live-proof

# Proof server (read by lib/proofAdapter.ts — server-side only, do NOT add NEXT_PUBLIC_ prefix).
PROOF_SERVER_URL=http://localhost:6300
